# ==============================================================================
# Dockerfile.watcher.dev: Vigilante y Compilador en Vivo de Estilos Tailwind CSS
# Ejecuta Tailwind CLI en modo watch con polling para compatibilidad con Windows/WSL2
# ==============================================================================
FROM node:22-alpine AS watcher
WORKDIR /app

# Instalar dependencias de npm
COPY package.json ./
RUN npm install --no-audit --no-fund

# Variables de entorno para asegurar detección de cambios en volúmenes compartidos
ENV CHOKIDAR_USEPOLLING=1
ENV WATCHPACK_POLLING=true

# Compilar inicialmente y activar el modo vigilancia continua (--watch --poll)
CMD ["npx", "tailwindcss", "-i", "./src/main/resources/static/css/tailwind-input.css", "-o", "./src/main/resources/static/css/tailwind.css", "--watch", "--poll"]
