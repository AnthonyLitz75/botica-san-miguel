# ==============================================================================
# Dockerfile.dev: Entorno de Desarrollo para Backend Spring Boot (Java 25)
# Permite Hot Reload de clases con DevTools, depuración remota JVM (puerto 5005)
# y desacoplamiento del empaquetado de producción de Render.
# ==============================================================================
FROM eclipse-temurin:25-jdk AS dev
WORKDIR /app

# Instalar herramientas para diagnóstico y monitoreo en contenedor
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Copiar configuración de Maven Wrapper
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./

# Normalizar saltos de línea (CRLF a LF) y permisos ejecutables
RUN sed -i 's/\r$//' mvnw && chmod +x mvnw

# Pre-descarga de dependencias offline para optimizar arranques
RUN ./mvnw dependency:go-offline -B -Dexec.skip=true || true

# Copiar scripts de desarrollo y orquestación
COPY entrypoint-dev.sh dev-java-watcher.sh ./
RUN sed -i 's/\r$//' entrypoint-dev.sh dev-java-watcher.sh && chmod +x entrypoint-dev.sh dev-java-watcher.sh

# Puertos expuestos: 8080 (Web), 5005 (Debug JDWP) y 35729 (LiveReload WebSocket)
EXPOSE 8080 5005 35729

# Configuración de variables de entorno para desarrollo
ENV SPRING_PROFILES_ACTIVE=dev

# Iniciar backend con el orquestador de desarrollo (Java Watcher + Spring Boot DevTools)
CMD ["/app/entrypoint-dev.sh"]
