# ==============================================================================
# Variables de Entorno de Desarrollo Local para Docker Compose
# Copia este archivo a .env para personalizar valores locales:
#   copy .env.example .env
# ==============================================================================

# Puerto Web del Servidor Backend en el Host
PORT=8080

# Puerto del Servidor PostgreSQL en el Host
# NOTA: Se usa 5433 para evitar colisión con servicios locales de PostgreSQL en 5432
DB_PORT_HOST=5433

# Credenciales de Base de Datos para el Contenedor
DB_NAME=farmacia_aed
DB_USER=postgres
DB_PASSWORD=postgres

# Puerto para Depuración Remota JVM (JDWP) en IntelliJ IDEA / VS Code
JVM_DEBUG_PORT=5005

# Puerto para Notificaciones LiveReload en el Navegador
LIVERELOAD_PORT=35729

# Perfil Activo de Spring Boot (dev habilita DevTools y datos demo)
SPRING_PROFILES_ACTIVE=dev

# Horizonte de Alertas de Inventario por Vencer (días)
DIAS_POR_VENCER=90
