{
  "name": "botica-san-miguel",
  "version": "1.0.0",
  "description": "Sistema Web de Gestión de Farmacia - Botica San Miguel",
  "scripts": {
    "build:css": "tailwindcss -i ./src/main/resources/static/css/tailwind-input.css -o ./src/main/resources/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/main/resources/static/css/tailwind-input.css -o ./src/main/resources/static/css/tailwind.css --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "tailwindcss": "^3.4.17"
  }
}
